# OS / editor junk
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# env & secrets - never committed (secrets-and-env golden rule #1)
.env
.env.*
!.env.example
*.pem
*.key

# logs & caches
*.log
__pycache__/
.cache/

# language build output
node_modules/
dist/
build/
target/
coverage/

# knowledge-platform build output - the emit targets declared in
# docs.config.json (build.incremental.manifest + build.output.*). Anchored to
# the content root so an authored llms.txt elsewhere in the tree still tracks.
/_site/
/_api/
/_pagefind/
/llms.txt
/llms-full.txt
/manifest.json

# wrangler local state
.wrangler/
